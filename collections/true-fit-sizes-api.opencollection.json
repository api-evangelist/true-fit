{
  "opencollection": "1.0.0",
  "info": {
    "name": "True Fit - Consumer Sizes API",
    "version": "3.0"
  },
  "items": [
    {
      "info": {
        "name": "Sizes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the available sizes for the given combination of brandId, category, gender, and age group.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/profile/public/v3/{tla}/sizes",
            "headers": [
              {
                "name": "X-TF-UserToken",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "category",
                "value": "",
                "type": "query"
              },
              {
                "name": "gender",
                "value": "",
                "type": "query"
              },
              {
                "name": "ageGroup",
                "value": "",
                "type": "query"
              },
              {
                "name": "locale",
                "value": "",
                "type": "query",
                "description": "Identifier specifying the locale to use when retrieving suggested brands or any type of sizes e.g. sizes, bra sizes, inseams or sleeve lengths. This attribute is only required when the store supports multiple locales. Use an ISO 639 language code followed by an ISO 3166 country code, e.g. en_US. "
              },
              {
                "name": "brandId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve the available sizes for the given combination of brandId, category, gender, and age group."
        },
        {
          "info": {
            "name": "Retrieve the size object based on a sizeId.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/profile/public/v3/{tla}/sizes/:sizeId",
            "headers": [
              {
                "name": "X-TF-UserToken",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "sizeId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the size object based on a sizeId."
        }
      ]
    }
  ],
  "bundled": true
}