          "info": {
            "name": "Retrieve the available brands for the given combination of category, gender, and age group.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/profile/public/v3/{tla}/brands",
            "headers": [
              {
                "name": "X-TF-UserToken",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "category",
                "value": "",
                "type": "query"
              },
              {
                "name": "gender",
                "value": "",
                "type": "query"
              },
              {
                "name": "ageGroup",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve the available brands for the given combination of category, gender, and age group."
        },
        {
          "info": {
            "name": "Retrieve the brand object based on a brandId.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/profile/public/v3/{tla}/brands/:brandId",
            "headers": [
              {
                "name": "X-TF-UserToken",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "brandId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the brand object based on a brandId."
        },
        {
          "info": {
            "name": "Retrieve the suggested brands for the given combination of category, gender, and age group.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/profile/public/v3/{tla}/brands/suggested",
            "headers": [
              {
                "name": "X-TF-UserToken",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "category",
                "value": "",
                "type": "query"
              },
              {
                "name": "gender",
                "value": "",
                "type": "query"
              },
              {
                "name": "ageGroup",
                "value": "",
                "type": "query"
              },
              {
                "name": "locale",
                "value": "",
                "type": "query",
                "description": "Identifier specifying the locale to use when retrieving suggested brands or any type of sizes e.g. sizes, bra sizes, inseams or sleeve lengths. This attribute is only required when the store supports multiple locales. Use an ISO 639 language code followed by an ISO 3166 country code, e.g. en_US. "
              },
              {
                "name": "age",
                "value": "",
                "type": "query",
                "description": "Specify to retrieve suggestions for this target age (in years)."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The max count of brands to return."
              }
            ]
          },
          "docs": "Retrieve the suggested brands for the given combination of category, gender, and age group."
        },
